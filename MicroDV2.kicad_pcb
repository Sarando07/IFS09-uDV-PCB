			(layer "F.Cu"
				(type "copper")
				(thickness 0.07)
			)
			(layer "dielectric 1"
				(type "core")
				(thickness 1.44)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
